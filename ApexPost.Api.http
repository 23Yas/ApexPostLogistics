### ApexPost API – dev requests (fictional data only)
### Get tokens first: POST {{baseUrl}}/dev/token {"courierId":"courier-001","role":"Courier"}
### Roles: devToken (any), courierToken (Courier), adminToken (Admin), partnerApiKey (X-Api-Key)

# ---------- v1 (deprecated) ----------

# Success: create shipment -> 201 + Location header
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-12345678",
  "weightKg": 2.5,
  "recipientName": "Jane Doe",
  "recipientPhone": "+15551234567",
  "recipientAddress": "123 Main St",
  "recipientCity": "Springfield",
  "price": 15.99
}

### Failure: duplicate tracking number -> 409
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-12345678",
  "weightKg": 2.5,
  "recipientName": "Jane Doe",
  "recipientPhone": "+15551234567",
  "recipientAddress": "123 Main St",
  "recipientCity": "Springfield",
  "price": 15.99
}

### Failure: validation error (bad tracking format) -> 400 ValidationProblemDetails
POST {{baseUrl}}/api/v1/shipments
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "BAD-123",
  "weightKg": 2.5,
  "recipientName": "Jane Doe",
  "recipientPhone": "+15551234567",
  "recipientAddress": "123 Main St",
  "recipientCity": "Springfield",
  "price": 15.99
}

### Success: paged list -> 200
GET {{baseUrl}}/api/v1/shipments?page=1&pageSize=20&status=Created&city=Springfield
Authorization: Bearer {{devToken}}

### Failure: unknown tracking number -> 404
GET {{baseUrl}}/api/v1/shipments/APX-00000000
Authorization: Bearer {{devToken}}

### Success: update shipment -> 200
PUT {{baseUrl}}/api/v1/shipments/APX-12345678
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-12345678",
  "weightKg": 3.0,
  "price": 18.50,
  "recipientName": "Jane Doe",
  "recipientPhone": "+15551234567",
  "recipientAddress": "123 Main St",
  "recipientCity": "Springfield"
}

### Failure: invalid status transition -> 409
PATCH {{baseUrl}}/api/v1/shipments/APX-12345678/status
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "status": "Delivered"
}

### Success: valid status transition -> 200
PATCH {{baseUrl}}/api/v1/shipments/APX-12345678/status
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "status": "PickedUp"
}

### Failure: delete non-Created shipment -> 409
DELETE {{baseUrl}}/api/v1/shipments/APX-12345678
Authorization: Bearer {{adminToken}}

### Success: delete Created shipment -> 204
DELETE {{baseUrl}}/api/v1/shipments/APX-87654321
Authorization: Bearer {{adminToken}}

### Success: bulk scan upload -> 200
POST {{baseUrl}}/api/v1/shipments/APX-12345678/scans
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "scans": [
    {
      "id": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
      "trackingNumber": "APX-12345678",
      "scanType": "Pickup",
      "courierId": "courier-001",
      "location": "Depot A",
      "scannedAtUtc": "2026-11-06T10:00:00Z",
      "notes": ""
    },
    {
      "id": "4fa85f64-5717-4562-b3fc-2c963f66afa7",
      "trackingNumber": "APX-12345678",
      "scanType": "Delivered",
      "courierId": "courier-001",
      "location": "123 Main St",
      "scannedAtUtc": "2026-11-06T14:00:00Z",
      "notes": "Signed: J. Doe"
    }
  ]
}

### Failure: scan validation (future time / missing signature) -> 400
POST {{baseUrl}}/api/v1/shipments/APX-12345678/scans
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "scans": [
    {
      "id": "5fa85f64-5717-4562-b3fc-2c963f66afa8",
      "trackingNumber": "APX-12345678",
      "scanType": "Delivered",
      "courierId": "courier-001",
      "location": "Depot A",
      "scannedAtUtc": "2099-01-01T00:00:00Z",
      "notes": ""
    }
  ]
}

### Failure: scan upload with another courierId -> 403
POST {{baseUrl}}/api/v1/shipments/APX-12345678/scans
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "scans": [
    {
      "id": "6fa85f64-5717-4562-b3fc-2c963f66afa9",
      "trackingNumber": "APX-12345678",
      "scanType": "Pickup",
      "courierId": "courier-999",
      "location": "Depot A",
      "scannedAtUtc": "2026-11-06T10:00:00Z",
      "notes": ""
    }
  ]
}

### Success: scan history -> 200
GET {{baseUrl}}/api/v1/shipments/APX-12345678/scans
Authorization: Bearer {{devToken}}

# ---------- v2 ----------

### Success: v2 paged list -> 200
GET {{baseUrl}}/api/v2/shipments?page=1&pageSize=20
Authorization: Bearer {{devToken}}

### Failure: v2 unknown tracking number -> 404
GET {{baseUrl}}/api/v2/shipments/APX-00000000
Authorization: Bearer {{devToken}}

### Success: v2 shipment with recipient object + latestScan -> 200
GET {{baseUrl}}/api/v2/shipments/APX-12345678
Authorization: Bearer {{devToken}}

### Success: v2 create shipment -> 201 + Location header
POST {{baseUrl}}/api/v2/shipments
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-22334455",
  "weightKg": 1.2,
  "recipientName": "John Smith",
  "recipientPhone": "+15557654321",
  "recipientAddress": "45 Oak Ave",
  "recipientCity": "Shelbyville",
  "price": 9.99
}

### Failure: v2 duplicate tracking number -> 409
POST {{baseUrl}}/api/v2/shipments
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-12345678",
  "weightKg": 1.2,
  "recipientName": "John Smith",
  "recipientPhone": "+15557654321",
  "recipientAddress": "45 Oak Ave",
  "recipientCity": "Shelbyville",
  "price": 9.99
}

### Failure: v2 validation error -> 400 ValidationProblemDetails
POST {{baseUrl}}/api/v2/shipments
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-12345678",
  "weightKg": 99,
  "recipientName": "",
  "recipientPhone": "not-a-phone",
  "recipientAddress": "45 Oak Ave",
  "recipientCity": "Shelbyville",
  "price": -5
}

### Success: v2 update shipment -> 200
PUT {{baseUrl}}/api/v2/shipments/APX-12345678
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-12345678",
  "weightKg": 3.5,
  "price": 21.00,
  "recipientName": "Jane Doe",
  "recipientPhone": "+15551234567",
  "recipientAddress": "123 Main St",
  "recipientCity": "Springfield"
}

### Failure: v2 tracking number mismatch -> 400
PUT {{baseUrl}}/api/v2/shipments/APX-12345678
Content-Type: application/json
Authorization: Bearer {{devToken}}

{
  "trackingNumber": "APX-99999999",
  "weightKg": 3.5,
  "price": 21.00,
  "recipientName": "Jane Doe",
  "recipientPhone": "+15551234567",
  "recipientAddress": "123 Main St",
  "recipientCity": "Springfield"
}

### Success: v2 status transition -> 200
PATCH {{baseUrl}}/api/v2/shipments/APX-12345678/status
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "status": "PickedUp"
}

### Failure: v2 invalid status transition -> 409
PATCH {{baseUrl}}/api/v2/shipments/APX-12345678/status
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "status": "Delivered"
}

### Failure: v2 unknown status -> 400
PATCH {{baseUrl}}/api/v2/shipments/APX-12345678/status
Content-Type: application/json
Authorization: Bearer {{courierToken}}

{
  "status": "Teleported"
}

