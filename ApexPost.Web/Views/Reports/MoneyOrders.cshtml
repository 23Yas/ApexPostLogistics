@{
    ViewData["Title"] = "Money orders";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Financial controls</p>
        <h1>Money orders and verification view</h1>
    </div>
    <div class="header-badge">@ViewBag.BranchCode</div>
</div>

<div class="panel">
    <div class="panel-header">
        <h3>Recent transaction activity</h3>
    </div>
    <div class="table-wrap">
        <table class="table modern-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Counter</th>
                    <th>Status</th>
                    <th>Total</th>
                    <th>Date</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is IEnumerable<dynamic> rows)
                {
                    foreach (var row in rows)
                    {
                        <tr>
                            <td>@row.Id</td>
                            <td>@row.CounterId</td>
                            <td>@row.Status</td>
                            <td>£@String.Format("{0:N2}", row.Total)</td>
                            <td>@row.CreatedAtUtc</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
