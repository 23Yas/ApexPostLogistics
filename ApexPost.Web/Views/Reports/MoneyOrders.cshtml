@{
    ViewData["Title"] = "Money orders";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Financial controls</p>
        <h1>Money orders and verification view</h1>
    </div>
    <div class="header-badge">@ViewBag.BranchCode</div>
</div>

<div class="panel">
    <div class="panel-header">
        <h3>Recent money orders</h3>
    </div>
    <div class="table-wrap">
        <table class="table modern-table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Sender</th>
                    <th>Recipient</th>
                    <th>Amount</th>
                    <th>Fee</th>
                    <th>Status</th>
                    <th>Verification</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is IEnumerable<dynamic> rows)
                {
                    foreach (var row in rows)
                    {
                        <tr>
                            <td>@row.Id</td>
                            <td>@row.Sender</td>
                            <td>@row.Recipient</td>
                            <td>£@String.Format("{0:N2}", row.Amount)</td>
                            <td>£@String.Format("{0:N2}", row.Fee)</td>
                            <td>@row.Status</td>
                            <td>@(row.RequiresIdentityVerification ? (row.IdentityVerificationComplete ? "Verified" : "Pending") : "Not required")</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
