@model IEnumerable<ApexPost.Core.Domain.CounterTransaction>
@{
    ViewData["Title"] = "Daily sales";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Operational reporting</p>
        <h1>Daily branch sales</h1>
    </div>
    <div class="header-badge">@ViewBag.BranchCode</div>
</div>

<div class="stat-strip mb-4">
    <div class="stat-card success">
        <span>Gross branch sales</span>
        <strong>£@String.Format("{0:N2}", ViewBag.Total)</strong>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <h3>Transactions for the current branch</h3>
    </div>
    <div class="table-wrap">
        <table class="table modern-table">
            <thead>
                <tr>
                    <th>Transaction</th>
                    <th>Counter</th>
                    <th>Status</th>
                    <th>Total</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Id</td>
                        <td>@item.CounterId</td>
                        <td>@item.Status</td>
                        <td>£@String.Format("{0:N2}", item.Total.Amount)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
