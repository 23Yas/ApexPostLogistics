@{
    ViewData["Title"] = "Shipping volume";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Postal operations</p>
        <h1>Shipping volume by service</h1>
    </div>
    <div class="header-badge">@ViewBag.BranchCode</div>
</div>

<div class="panel">
    <div class="panel-header">
        <h3>Service usage</h3>
    </div>
    <div class="table-wrap">
        <table class="table modern-table">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Count</th>
                    <th>Value</th>
                </tr>
            </thead>
            <tbody>
                @if (Model is IEnumerable<dynamic> rows)
                {
                    foreach (var row in rows)
                    {
                        <tr>
                            <td>@row.ServiceCode</td>
                            <td>@row.Count</td>
                            <td>£@String.Format("{0:N2}", row.TotalValue)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
