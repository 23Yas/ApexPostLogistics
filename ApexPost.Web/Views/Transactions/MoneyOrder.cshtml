@{
    ViewData["Title"] = "Money order";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Financial services</p>
        <h1>Money order</h1>
    </div>
    <div class="header-badge">Branch @ViewBag.BranchCode</div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="panel">
    <form asp-action="MoneyOrder" method="post" class="transaction-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label" for="amount">Amount</label>
                <input id="amount" name="amount" type="number" min="1" step="0.01" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="fee">Fee</label>
                <input id="fee" name="fee" type="number" min="0" step="0.01" class="form-control" value="2.50" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="sender">Sender</label>
                <input id="sender" name="sender" type="text" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="recipient">Recipient</label>
                <input id="recipient" name="recipient" type="text" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label" for="documentType">Document type</label>
                <select id="documentType" name="documentType" class="form-select">
                    <option value="">Not required</option>
                    <option value="Passport">Passport</option>
                    <option value="Driving licence">Driving licence</option>
                    <option value="National ID">National ID</option>
                </select>
            </div>
            <div class="col-md-6">
                <label class="form-label" for="maskedIdentifier">Masked identifier</label>
                <input id="maskedIdentifier" name="maskedIdentifier" type="text" class="form-control" placeholder="Last 4 digits only" />
            </div>
        </div>

        <div class="alert alert-light mt-4">
            Amounts above £@ViewBag.Threshold.ToString("N2") require successful identity verification in the same transaction.
        </div>

        <div class="d-flex gap-2 mt-3">
            <button type="submit" class="btn btn-primary">Submit money order</button>
            <a asp-controller="Transactions" asp-action="IdentityVerification" class="btn btn-outline-primary">Record verification</a>
        </div>
    </form>
</div>
