@{
    ViewData["Title"] = "New transaction";
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Counter operations</p>
        <h1>New counter transaction</h1>
    </div>
    <div class="header-badge">@ViewBag.BranchCode</div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="alert alert-success">@successMessage</div>
}

<div class="row g-4">
    <div class="col-lg-5">
        <div class="panel">
            <div class="panel-header">
                <h3>Quick sale</h3>
            </div>
            <form asp-action="Create" method="post" class="transaction-form">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label class="form-label" for="productSku">Product</label>
                    <select id="productSku" name="productSku" class="form-select" required>
                        @if (ViewBag.ProductRows is IEnumerable<dynamic> products)
                        {
                            foreach (var row in products)
                            {
                                <option value="@row.Product.Sku.Value">@row.Product.Name (@row.Product.Sku.Value) - @row.QuantityOnHand in stock</option>
                            }
                        }
                    </select>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="quantity">Quantity</label>
                        <input type="number" id="quantity" name="quantity" class="form-control" min="1" value="1" required />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="paymentMethod">Payment</label>
                        <select id="paymentMethod" name="paymentMethod" class="form-select">
                            <option value="Card">Card</option>
                            <option value="Cash">Cash</option>
                            <option value="Mobile">Mobile</option>
                            <option value="MoneyOrder">Money order</option>
                        </select>
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="serviceLevel">Optional shipping service</label>
                    <select id="serviceLevel" name="serviceLevel" class="form-select">
                        <option value="None">No shipping</option>
                        @foreach (var option in ViewBag.ServiceLevels ?? Enumerable.Empty<string>())
                        {
                            <option value="@option">@option</option>
                        }
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="counterId">Counter terminal</label>
                    <input type="text" id="counterId" name="counterId" class="form-control" value="C1" required />
                </div>

                <button type="submit" class="btn btn-primary btn-lg w-100">Record transaction</button>
            </form>
        </div>
    </div>

    <div class="col-lg-7">
        <div class="panel">
            <div class="panel-header">
                <h3>Available catalogue</h3>
            </div>
            <div class="table-wrap">
                <table class="table modern-table">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Product</th>
                            <th>Unit price</th>
                            <th>Stock</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.ProductRows is IEnumerable<dynamic> productRows)
                        {
                            foreach (var row in productRows)
                            {
                                <tr>
                                    <td>@row.Product.Sku.Value</td>
                                    <td>@row.Product.Name</td>
                                    <td>£@String.Format("{0:N2}", row.Product.UnitPrice.Amount)</td>
                                    <td>@row.QuantityOnHand</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
