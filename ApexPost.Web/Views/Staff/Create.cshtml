@{
    ViewData["Title"] = "Add staff";
    var branches = ViewBag.Branches as IEnumerable<ApexPost.Core.Domain.Branch> ?? Array.Empty<ApexPost.Core.Domain.Branch>();
    var roles = ViewBag.Roles as IEnumerable<string> ?? Array.Empty<string>();
}

<div class="page-header mb-4">
    <div>
        <p class="eyebrow text-uppercase">Administration</p>
        <h1>Add staff member</h1>
    </div>
</div>

<div class="panel">
    <form asp-action="Create" method="post" class="transaction-form">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label class="form-label">Full name</label>
                <input name="name" class="form-control" required />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email address</label>
                <input name="email" type="email" class="form-control" required />
            </div>
            <div class="col-md-12">
                <label class="form-label">Password</label>
                <input name="password" type="password" class="form-control" minlength="8" required />
            </div>
            <div class="col-md-4">
                <label class="form-label">Role</label>
                <select name="role" class="form-select">
                    @foreach (var role in roles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Home branch</label>
                <select name="homeBranch" class="form-select">
                    @foreach (var branch in branches)
                    {
                        <option value="@branch.Code.Value">@branch.Name (@branch.Code.Value)</option>
                    }
                </select>
            </div>
            <div class="col-md-4">
                <label class="form-label">Status</label>
                <select name="isActive" class="form-select">
                    <option value="true" selected>Active</option>
                    <option value="false">Inactive</option>
                </select>
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save staff</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </form>
</div>
