  "components": {
    "schemas": {
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "weightKg",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "^APX-\\d{8}$",
            "type": "string",
            "description": "Tracking number in the format APX-XXXXXXXX (8 digits)."
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Parcel weight in kilograms (0.1 - 70).",
            "format": "double"
          },
          "recipientName": {
            "type": "string",
            "description": "Full name of the recipient."
          },
          "recipientPhone": {
            "type": "string",
            "description": "Recipient phone number in a valid international format."
          },
          "recipientAddress": {
            "type": "string",
            "description": "Street address of the recipient."
          },
          "recipientCity": {
            "type": "string",
            "description": "City of the recipient."
          },
          "price": {
            "maximum": 100000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Shipping price in the local currency (non-negative).",
            "format": "double"
          }
        },
        "description": "Request body for creating a new shipment."
      },
      "DevTokenRequest": {
        "type": "object",
        "properties": {
          "courierId": {
            "type": [
              "null",
              "string"
            ]
          },
          "role": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "ScanRejectionDto": {
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "description": "ID of the rejected scan.",
            "format": "uuid"
          },
          "reason": {
            "type": "string",
            "description": "Machine-readable rejection reason."
          }
        },
        "description": "Reason a single scan was rejected during bulk upload."
      },
      "ScanType": {
        "enum": [
          "Pickup",
          "InTransit",
          "Delivered",
          "Failed"
        ],
        "description": "Kind of scan event recorded by a courier."
      },
      "ScanUploadRequest": {
        "type": "object",
        "properties": {
          "scans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentScanDto"
            },
            "description": "Scans to upload; each carries its client-generated ID for idempotent de-duplication."
          }
        },
        "description": "Request body for bulk upload of offline-collected shipment scans."
      },
      "ScanUploadResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of scans persisted.",
            "format": "int32"
          },
          "duplicatesSkipped": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of scans skipped because their ID was already stored.",
            "format": "int32"
          },
          "rejected": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "description": "Number of scans rejected by validation.",
            "format": "int32"
          },
          "rejections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRejectionDto"
            },
            "description": "Per-scan rejection reasons (scan ID plus reason code)."
          }
        },
        "description": "Response body for a bulk scan upload: counts of accepted, de-duplicated and rejected scans."
      },
      "ShipmentResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique shipment identifier.",
            "format": "uuid"
          },
          "trackingReference": {
            "type": "string",
            "description": "Tracking reference in the format APX-XXXXXXXX."
          },
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Parcel weight in kilograms.",
            "format": "double"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Shipping price in the local currency.",
            "format": "double"
          },
          "serviceLevel": {
            "type": "string",
            "description": "Service level applied to the shipment."
          },
          "status": {
            "type": "string",
            "description": "Current lifecycle status (Created, PickedUp, InTransit, OutForDelivery, Delivered, Failed)."
          },
          "recipientName": {
            "type": "string",
            "description": "Full name of the recipient."
          },
          "recipientPhone": {
            "type": "string",
            "description": "Recipient phone number."
          },
          "recipientAddress": {
            "type": "string",
            "description": "Street address of the recipient."
          },
          "recipientCity": {
            "type": "string",
            "description": "City of the recipient."
          },
          "createdAtUtc": {
            "type": "string",
            "description": "UTC time the shipment was created.",
            "format": "date-time"
          }
        },
        "description": "v1 shipment response. Exposes only the public contract fields - internal\r\nlinkage such as counter transaction, branch and zone identifiers is hidden."
      },
      "ShipmentScanDto": {
        "required": [
          "trackingNumber",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Client-generated scan ID; re-uploads of the same ID are de-duplicated.",
            "format": "uuid"
          },
          "trackingNumber": {
            "type": "string",
            "description": "Tracking number the scan belongs to; must match the route."
          },
          "scanType": {
            "description": "Type of scan event.",
            "$ref": "#/components/schemas/ScanType"
          },
          "courierId": {
            "type": "string",
            "description": "Courier who performed the scan; must match the caller's courierId claim."
          },
          "location": {
            "type": "string",
            "description": "Free-text location where the scan was taken."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "UTC time the scan was captured on the device.",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes; required for Delivered scans (recipient signature)."
          }
        },
        "description": "A single offline scan uploaded for a shipment."
      },
      "ShipmentScanResponse": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique scan identifier (client-generated, used for de-duplication).",
            "format": "uuid"
          },
          "trackingNumber": {
            "type": "string",
            "description": "Tracking number the scan belongs to."
          },
          "scanType": {
            "type": "string",
            "description": "Type of scan event (Pickup, InTransit, Delivered, Failed)."
          },
          "courierId": {
            "type": "string",
            "description": "Courier who performed the scan."
          },
          "location": {
            "type": "string",
            "description": "Free-text location where the scan was taken."
          },
          "scannedAtUtc": {
            "type": "string",
            "description": "UTC time the scan was captured.",
            "format": "date-time"
          },
          "notes": {
            "type": "string",
            "description": "Optional notes (recipient signature for Delivered scans)."
          }
        },
        "description": "v1 scan response for a single recorded scan event."
      },
      "UpdateShipmentRequest": {
        "required": [
          "trackingNumber",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "^APX-\\d{8}$",
            "type": "string",
            "description": "Tracking number; must match the tracking number in the route."
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Parcel weight in kilograms (0.1 - 70).",
            "format": "double"
          },
          "price": {
            "maximum": 100000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "description": "Shipping price in the local currency (non-negative).",
            "format": "double"
          },
          "recipientName": {
            "maxLength": 200,
            "minLength": 0,
            "type": "string",
            "description": "Full name of the recipient."
          },
          "recipientPhone": {
            "maxLength": 32,
            "minLength": 0,
            "type": "string",
            "description": "Recipient phone number in a valid international format."
          },
          "recipientAddress": {
            "maxLength": 400,
            "minLength": 0,
            "type": "string",
            "description": "Street address of the recipient."
          },
          "recipientCity": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string",
            "description": "City of the recipient."
          }
        },
        "description": "Request body for replacing the editable details of an existing shipment."
      },
      "UpdateStatusRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "description": "Target status; must be a known shipment status and a valid transition."
          }
        },
        "description": "Request body for changing only the status of a shipment."
      }
