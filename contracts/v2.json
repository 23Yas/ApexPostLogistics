{
  "openapi": "3.0.1",
  "info": {
    "title": "ApexPost Logistics API",
    "version": "v2",
    "description": "RESTful API for ApexPost Logistics shipment tracking and management (v2 - recipient object and latestScan summary)",
    "contact": { "name": "ApexPost API Team", "email": "api-team@apexpost.local" }
  },
  "paths": {
    "/api/v2/shipments": {
      "get": {
        "tags": ["Shipments"],
        "summary": "Get paged shipments",
        "operationId": "GetShipments",
        "parameters": [
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 1 } },
          { "name": "pageSize", "in": "query", "schema": { "type": "integer", "default": 20, "maximum": 50 } },
          { "name": "status", "in": "query", "schema": { "type": "string" } },
          { "name": "city", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" }, "400": { "description": "Bad Request" } }
      },
      "post": {
        "tags": ["Shipments"],
        "summary": "Create a new shipment",
        "operationId": "CreateShipment",
        "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/CreateShipmentRequest" } } } },
        "responses": {
          "201": { "description": "Created", "headers": { "Location": { "schema": { "type": "string" } } } },
          "400": { "description": "Bad Request" },
          "409": { "description": "Conflict" }
        }
      }
    },
    "/api/v2/shipments/{trackingNumber}": {
      "get": {
        "tags": ["Shipments"],
        "summary": "Get shipment by tracking number",
        "operationId": "GetShipment",
        "parameters": [ { "name": "trackingNumber", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "OK", "content": { "application/json": { "schema": { "$ref": "#/components/schemas/ShipmentResponseV2" } } } }, "404": { "description": "Not Found" } }
      }
    },
    "/api/v2/shipments/{trackingNumber}/status": {
      "patch": {
        "tags": ["Shipments"],
        "summary": "Update shipment status",
        "operationId": "UpdateShipmentStatus",
        "parameters": [ { "name": "trackingNumber", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "OK" }, "400": { "description": "Bad Request" }, "404": { "description": "Not Found" }, "409": { "description": "Conflict" } }
      }
    },
    "/api/v2/shipments/{trackingNumber}/scans": {
      "post": {
        "tags": ["Scans"],
        "summary": "Bulk upload shipment scans",
        "operationId": "UploadScans",
        "parameters": [ { "name": "trackingNumber", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "OK" }, "400": { "description": "Bad Request" }, "404": { "description": "Not Found" } }
      },
      "get": {
        "tags": ["Scans"],
        "summary": "Get shipment scan history",
        "operationId": "GetScans",
        "parameters": [ { "name": "trackingNumber", "in": "path", "required": true, "schema": { "type": "string" } } ],
        "responses": { "200": { "description": "OK" }, "404": { "description": "Not Found" } }
      }
    },
    "/api/v2/partner/shipments/{trackingNumber}": {
      "get": {
        "tags": ["Partner"],
        "summary": "Partner read-only shipment lookup (X-Api-Key)",
        "operationId": "GetPartnerShipment",
        "parameters": [
          { "name": "trackingNumber", "in": "path", "required": true, "schema": { "type": "string" } },
          { "name": "X-Api-Key", "in": "header", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "OK" }, "401": { "description": "Unauthorized" }, "404": { "description": "Not Found" } }
      }
    }
  },
  "components": {
    "schemas": {
      "ShipmentResponseV2": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "trackingNumber": { "type": "string" },
          "weightKg": { "type": "number" },
          "price": { "type": "number" },
          "status": { "type": "string", "enum": ["Created", "PickedUp", "InTransit", "OutForDelivery", "Delivered", "Failed"] },
          "recipient": { "$ref": "#/components/schemas/RecipientDto" },
          "latestScan": { "$ref": "#/components/schemas/LatestScanDto" },
          "createdAtUtc": { "type": "string", "format": "date-time" }
        }
      },
      "RecipientDto": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "phone": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" }
        }
      },
      "LatestScanDto": {
        "type": "object",
        "properties": {
          "scanType": { "type": "string" },
          "location": { "type": "string" },
          "scannedAtUtc": { "type": "string", "format": "date-time" }
        }
      },
      "CreateShipmentRequest": {
        "type": "object",
        "required": ["trackingNumber", "weightKg", "recipientName", "recipientPhone", "recipientAddress", "recipientCity"],
        "properties": {
          "trackingNumber": { "type": "string", "pattern": "^APX-\\d{8}$" },
          "weightKg": { "type": "number", "minimum": 0.1, "maximum": 70 },
          "recipientName": { "type": "string" },
          "recipientPhone": { "type": "string" },
          "recipientAddress": { "type": "string" },
          "recipientCity": { "type": "string" },
          "price": { "type": "number" }
        }
      }
    }
  }
}
