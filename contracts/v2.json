      },
      "ShipmentScanDto": {
        "required": [
          "trackingNumber",
          "scanType",
          "courierId",
          "location",
          "scannedAtUtc"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trackingNumber": {
            "type": "string"
          },
          "scanType": {
            "$ref": "#/components/schemas/ScanType"
          },
          "courierId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
          }
        }
      },
      "UpdateShipmentRequest": {
        "required": [
          "trackingNumber"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "^APX-\\d{8}$",
            "type": "string"
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "price": {
            "maximum": 100000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "recipientName": {
            "type": [
              "null",
              "string"
            ]
          },
          "recipientPhone": {
            "type": [
              "null",
              "string"
            ]
          },
          "recipientAddress": {
            "type": [
              "null",
              "string"
            ]
          },
          "recipientCity": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "UpdateStatusRequest": {
