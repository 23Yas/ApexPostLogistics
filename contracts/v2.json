  "components": {
    "schemas": {
      "BranchCode": {
        "type": "object",
        "properties": {
          "value": {
            "type": "string"
          }
        }
      },
      "CreateShipmentRequest": {
        "required": [
          "trackingNumber",
          "weightKg",
          "recipientName",
          "recipientPhone",
          "recipientAddress",
          "recipientCity"
        ],
        "type": "object",
        "properties": {
          "trackingNumber": {
            "pattern": "^APX-\\d{8}$",
            "type": "string"
          },
          "weightKg": {
            "maximum": 70,
            "minimum": 0.1,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "recipientName": {
            "type": "string"
          },
          "recipientPhone": {
            "type": "string"
          },
          "recipientAddress": {
            "type": "string"
          },
          "recipientCity": {
            "type": "string"
          },
          "price": {
            "maximum": 100000,
            "minimum": 0,
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "LatestScanDto": {
        "type": "object",
        "properties": {
          "scanType": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ]
          },
          "title": {
            "type": [
              "null",
              "string"
            ]
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          },
          "instance": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "RecipientDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "address": {
            "type": "string"
          },
          "city": {
            "type": "string"
          }
        }
      },
      "ScanRejectionDto": {
        "type": "object",
        "properties": {
          "scanId": {
            "type": "string",
            "format": "uuid"
          },
          "reason": {
            "type": "string"
          }
        }
      },
      "ScanType": {
        "type": "integer"
      },
      "ScanUploadRequest": {
        "type": "object",
        "properties": {
          "scans": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ShipmentScanDto"
            }
          }
        }
      },
      "ScanUploadResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "duplicatesSkipped": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rejected": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "rejections": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScanRejectionDto"
            }
          }
        }
      },
      "ServiceLevel": {
        "type": "integer"
      },
      "Shipment": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "counterTransactionId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "branchCode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/BranchCode"
              }
            ]
          },
          "zoneId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "serviceLevel": {
            "$ref": "#/components/schemas/ServiceLevel"
          },
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "trackingReference": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "recipientName": {
            "type": "string"
          },
          "recipientPhone": {
            "type": "string"
          },
          "recipientAddress": {
            "type": "string"
          },
          "recipientCity": {
            "type": "string"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ShipmentResponseV2": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trackingNumber": {
            "type": "string"
          },
          "weightKg": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "price": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d+)?$",
            "type": [
              "number",
              "string"
            ],
            "format": "double"
          },
          "status": {
            "type": "string"
          },
          "recipient": {
            "$ref": "#/components/schemas/RecipientDto"
          },
          "latestScan": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "$ref": "#/components/schemas/LatestScanDto"
              }
            ]
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ShipmentScan": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "trackingNumber": {
            "type": "string"
          },
          "scanType": {
            "$ref": "#/components/schemas/ScanType"
          },
          "courierId": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "scannedAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "notes": {
            "type": "string"
