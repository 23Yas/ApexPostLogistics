<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ApexPost.Courier.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:ApexPost.Courier.Pages"
    Title="ApexPost Courier">

    <ShellContent
        Title="Login"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login" />

    <ShellContent
        Title="Pending"
        ContentTemplate="{DataTemplate pages:PendingScansPage}"
        Route="pending" />

    <ShellContent
        Title="New Scan"
        ContentTemplate="{DataTemplate pages:NewScanPage}"
        Route="newscan" />

    <ShellContent
        Title="Sync Status"
        ContentTemplate="{DataTemplate pages:SyncStatusPage}"
        Route="syncstatus" />

    <TabBar>
        <ShellContent Title="Pending" Route="pending" ContentTemplate="{DataTemplate pages:PendingScansPage}" />
        <ShellContent Title="New Scan" Route="newscan" ContentTemplate="{DataTemplate pages:NewScanPage}" />
        <ShellContent Title="Sync" Route="syncstatus" ContentTemplate="{DataTemplate pages:SyncStatusPage}" />
    </TabBar>

</Shell>
