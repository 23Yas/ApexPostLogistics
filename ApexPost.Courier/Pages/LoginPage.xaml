<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApexPost.Courier.Pages.LoginPage"
             Title="Login">
    <VerticalStackLayout Padding="30" Spacing="15">
        <Label Text="ApexPost Courier" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" />
        <Label Text="Paste a development JWT token to continue" FontSize="14" TextColor="Gray" />
        <Editor x:Name="TokenEditor" Placeholder="eyJhbGciOi..." HeightRequest="120" AutoSize="TextChanges" />
        <Button Text="Save Token &amp; Continue" Clicked="OnLoginClicked" />
        <Label x:Name="StatusLabel" TextColor="Red" />
    </VerticalStackLayout>
</ContentPage>
