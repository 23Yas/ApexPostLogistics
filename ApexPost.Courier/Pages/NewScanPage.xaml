<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApexPost.Courier.Pages.NewScanPage"
             Title="New Scan">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="10">
            <Label Text="New Shipment Scan" FontSize="22" FontAttributes="Bold" />
            <Entry x:Name="TrackingEntry" Placeholder="Tracking number (APX-XXXXXXXX)" />
            <Picker x:Name="ScanTypePicker" Title="Scan type" />
            <Entry x:Name="CourierEntry" Placeholder="Courier ID" Text="courier-001" />
            <Entry x:Name="LocationEntry" Placeholder="Location" />
            <Editor x:Name="NotesEntry" Placeholder="Notes (recipient signature required for Delivered)" HeightRequest="80" />
            <Button Text="Save Scan (offline-first)" Clicked="OnSaveClicked" />
            <Label x:Name="StatusLabel" TextColor="Green" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
