<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ApexPost.Courier.Pages.SyncStatusPage"
             Title="Sync Status">
    <VerticalStackLayout Padding="20" Spacing="12">
        <Label Text="Sync Status" FontSize="22" FontAttributes="Bold" />
        <Label x:Name="LastSyncLabel" />
        <Label x:Name="CircuitLabel" />
        <Label x:Name="FailuresLabel" />
        <Label x:Name="OfflineBanner" Text="Server unavailable – working offline"
               TextColor="Orange" FontAttributes="Bold" IsVisible="False" />
        <Button Text="Back" Clicked="OnBackClicked" />
    </VerticalStackLayout>
</ContentPage>
